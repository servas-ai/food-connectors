  {
   "id": 4793543426122,
   "title": "Probierpaket",
   "handle": "probierpaket",
   "body_html": "<div class=\"page\" title=\"Page 1\">\n<div class=\"section\">\n<div class=\"layoutArea\">\n<div class=\"column\">\n<p><meta charset=\"utf-8\">Teste unsere beliebtesten <meta charset=\"utf-8\"><span>Bio-Gerichte sowie unser neues Gelbes Thai Curry im Probierpaket</span>. <meta charset=\"utf-8\"><span class=\"x7amdea\">Schon ab</span><strong class=\"x7amdea\"> 4,99 € pro Portion – und 2× Protein Pasta gibt’s gratis dazu!</strong></p>\n<ul style=\"font-family: -apple-system, BlinkMacSystemFont, 'San Francisco', 'Segoe UI', Roboto, 'Helvetica Neue', sans-serif; font-size: 1rem;\">\n<li>1 x African Bowl</li>\n<li>1 x Chili Sin Carne</li>\n<li>1 x Chipotle Chili</li>\n<li>1 x Mediterranes Hühnchen</li>\n<li>1 x Kichererbsen Curry</li>\n<li>1 x Erdnuss Curry</li>\n<li>1 x Linsen Dal</li>\n<li>1x Butter Chicken</li>\n<li>1 x <meta charset=\"utf-8\"> Classic Bolognese</li>\n<li>1x Paprika Hähnchen<br>\n</li>\n<li>1x Hühner Frikassee</li>\n<li>1x Gelbes Thai Curry <meta charset=\"utf-8\">🆕</li>\n<li>2x gratis Protein Pasta <meta charset=\"utf-8\"> <span>🍝</span><meta charset=\"utf-8\"> <span>🍝</span><meta charset=\"utf-8\">\n</li>\n</ul>\n</div>\n</div>\n</div>\n</div>",
