rue\"></span></span></summary>\n<div class=\"nw-body\">\n<table class=\"nw-table\">\n<thead>\n<tr>\n<th>Durchschnittliche Nährwerte</th>\n<td>pro 100 g</td>\n<td>pro Knödel (125 g)</td>\n</tr>\n</thead>\n<tbody>\n<tr>\n<th>Brennwert</th>\n<td>771 kJ / 185 kcal</td>\n<td>964 kJ / 231 kcal</td>\n</tr>\n<tr>\n<th>Fett</th>\n<td>6,5 g</td>\n<td>8,2 g</td>\n</tr>\n<tr class=\"nw-sub\">\n<th>davon gesättigte Fettsäuren</th>\n<td>3,3 g</td>\n<td>4,1 g</td>\n</tr>\n<tr>\n<th>Kohlenhydrate</th>\n<td>23,8 g</td>\n<td>29,7 g</td>\n</tr>\n<tr class=\"nw-sub\">\n<th>davon Zucker</th>\n<td>1,0 g</td>\n<td>1,3 g</td>\n</tr>\n<tr>\n<th>Ballaststoffe</th>\n<td>1,5 g</td>\n<td>1,9 g</td>\n</tr>\n<tr>\n<th>Eiweiß</th>\n<td>6,6 g</td>\n<td>8,3 g</td>\n</tr>\n<tr>\n<th>Salz</th>\n<td>2,06 g</td>\n<td>2,57 g</td>\n</tr>\n</tbody>\n</table>\n<p class=\"nw-note\">Portionsgröße: 1 Knödel = 125 g, eine Packung enthält 4 Stück (500 g). Die Werte pro 100 g beziehen sich auf die Rezeptur vor dem Kochen.</p>\n</div>\n</details>\n<p><!-- nw:end --></p>","on_sale":false,"prices":{"price":"900","regular_price":"900","sale_price":"900","price_range":null,"currency_code":"EUR","currency_symbol":"€","currency_minor_unit":2,"currency_decimal_separator":",","currency_thousand_separator":" ","currency_prefix":"€ ","currency_suffix":""},"price_html":"<span class=\"woocommerce-Price-amount amount\"><span class=\"woocommerce-Price-currencySymbol\" dir=\"auto\">&euro;</span>&nbsp;9,00</span>","average_rating":"0","review_count":0,"images":[{"id":133,"src":"https://www.noglu.at/wp-content/uploads/2026/06/kasnocken.jpg","thumbnail":"https://www.noglu.at/wp-content/uploads/2026/06/kasnocken-300x300.jpg","srcset":"https://www.noglu.at/wp-content/uploads/2026/06/kasnocken.jpg 490w, https://www.noglu.at/wp-content/uploads/2026/06/kasnocken-300x201.jpg 300w","sizes":"(max-width: 490px) 100vw, 490px","thumbnail_srcset":"https://www.noglu.at/wp-content/uploads/2026/06/kasnocken-300x300.jpg 300w, https://www.noglu.at/